# Non-secret settings for Peril. Secrets go in $PERIL_DATA_DIR/secrets/<name>, mode 600.
# Never paste a secret into this file or into chat.

PERIL_OWNER_NAME=Kartik
PERIL_OWNER_PHONE=+91XXXXXXXXXX
PERIL_OWNER_EMAIL=
PERIL_TIMEZONE=Asia/Kolkata

# The Sprite URL from `sprite url -s peril`, no trailing slash.
PERIL_PUBLIC_URL=

# Model ids from Kiro's /model list. Empty uses Kiro's chat.defaultModel.
PERIL_CHAT_MODEL=
PERIL_DEEP_MODEL=

# Photon (Spectrum, Stable). The project secret and webhook secret go in
# secrets/photon-project-secret and secrets/photon-webhook-secret.
PERIL_PHOTON_PROJECT_ID=

# Sprites connector gateway URLs, from `curl -s https://api.sprites.dev/v1/gateway/list`
# run inside the Sprite. Example: https://api.sprites.dev/v1/gateway/composio/conn_abc123
PERIL_COMPOSIO_GATEWAY=
PERIL_COMPOSIO_USER_ID=default
PERIL_COMPOSIO_TOOLKITS=gmail,googlecalendar
PERIL_CRONJOB_GATEWAY=

PERIL_QUIET_HOURS=21-8
PERIL_BRIEFING_CRON="30 8 * * *"
PERIL_NIGHTLY_CRON="0 3 * * *"
